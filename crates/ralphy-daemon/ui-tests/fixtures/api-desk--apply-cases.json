    "changed": true,
    "expect": {
      "windows": [{ "id": "w-1", "repo": "o/r", "agent": "console", "kind": "console", "rect": { "left": 100, "top": 100, "width": 600, "height": 400 }, "max": true, "sessionId": 7, "locked": true, "ts": 1 }],
      "fences": [], "notes": [], "checkouts": {}
    }
  }
