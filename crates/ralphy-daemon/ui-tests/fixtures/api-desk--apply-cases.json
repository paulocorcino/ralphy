      "checkouts": {}
    }
  },
  {
    "name": "a closed card and its undo come back at the end",
    "desk": {
      "windows": [], "fences": [],
      "notes": [
        { "id": "n-1", "repo": "o/r", "path": "a.note", "rect": { "left": 80, "top": 120, "width": 240, "height": 180 }, "ts": 1 },
        { "id": "n-2", "repo": "o/r", "path": "b.note", "rect": { "left": 380, "top": 120, "width": 240, "height": 180 }, "ts": 1 }
      ],
      "checkouts": {}
    },
    "changes": [
      { "op": "remove", "type": "note", "id": "n-1" },
      { "op": "create", "type": "note", "record": { "id": "n-1", "repo": "o/r", "path": "a.note", "rect": { "left": 80, "top": 120, "width": 240, "height": 180 }, "ts": 1 } }
    ],
    "changed": true,
    "expect": {
      "windows": [], "fences": [],
      "notes": [
        { "id": "n-2", "repo": "o/r", "path": "b.note", "rect": { "left": 380, "top": 120, "width": 240, "height": 180 }, "ts": 1 },
        { "id": "n-1", "repo": "o/r", "path": "a.note", "rect": { "left": 80, "top": 120, "width": 240, "height": 180 }, "ts": 1 }
      ],
      "checkouts": {}
    }
  },
  {
    "name": "maximize and lock are fields of their own",
    "desk": {
      "windows": [{ "id": "w-1", "repo": "o/r", "agent": "console", "kind": "console", "rect": { "left": 100, "top": 100, "width": 600, "height": 400 }, "max": false, "sessionId": 7, "ts": 1 }],
      "fences": [], "notes": [], "checkouts": {}
    },
