{
  "gitignore": true,
  "globs": ["**/*.md"],
  "ignores": [
    "CHANGELOG.md",
    "assets/**",
    "changelog.d/**",
    "**/vendor/**",
    "docs/plans/**",
    ".ralphy/**",
    "worktrees/**",
    "target/**",
    "node_modules/**"
  ],
  "config": {
    "default": true,
    // MD013 (line length) is off by D9: it wraps prose and the repo does not wrap
    "MD013": false,
    // debt: 219 sites
    "MD033": false,
    // debt: 147 sites
    "MD040": false
  }
}
