{
  "gitignore": true,
  "globs": ["**/*.md"],
  "ignores": [
    "CHANGELOG.md",
    "assets/**",
    "changelog.d/**",
    "**/vendor/**",
    "docs/plans/**",
    ".ralphy/**",
    "worktrees/**",
    "target/**",
    "node_modules/**"
  ],
  "config": {
    "default": true,
    // MD013 (line length) is off by D9: it wraps prose and the repo does not wrap
    "MD013": false,
    // br breaks lines in the table cells of the converted papers in docs/research;
    // p and img set the phone screenshots of the README side by side
    "MD033": { "allowed_elements": ["br", "p", "img"] },
    // MD060 (table pipe style) is off: a style of the source only, and --fix cannot reach 0
    "MD060": false
  }
}
