{
  // Lints the workbench JS: crates/ralphy-daemon/assets/ui and ui-tests.
  "plugins": ["eslint", "unicorn", "oxc", "typescript"],
  "categories": { "correctness": "error" },
  "env": { "browser": true, "es2024": true },
  "ignorePatterns": ["**/vendor/**"],
  "rules": {
    // Every `for (… of [...coll])` in the UI is a snapshot taken because the
    // loop body mutates `coll`. Removing the spread would break that loop.
    "unicorn/no-useless-spread": "off",
    // wb-project.js matches control characters on purpose: a worktree name
    // must not contain them.
    "no-control-regex": "off",
    "no-unused-vars": ["error", { "args": "none", "caughtErrors": "none", "ignoreRestSiblings": true }],
    // `== null` is the one loose comparison the UI uses: it means null or undefined.
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    // `catch {}` is used where the failure has no reader, such as closing a
    // socket that is already gone.
    "no-empty": ["error", { "allowEmptyCatch": true }],
    // A new `any` is refused. The modules that still have one are listed in the
    // override below (ADR-0075 D6: narrowing them is later work).
    "typescript/no-explicit-any": "error",
    // `scrim()` in app.ts keeps `this` as `self`: Alpine calls `x-effect` with
    // its own `this`, so the arrow-function fix does not apply there.
    "typescript/no-this-alias": "off"
  },
  "overrides": [
    { "files": ["**/ui-tests/**"], "env": { "node": true } },
    {
      // The modules that had an explicit `any` when the rule was turned on.
      // The list only gets shorter: a module leaves it when its last `any`
      // goes. A new module starts at zero and is never added here.
      // `explicit_any_matches_the_baseline` (crates/xtask/tests/ratchets.rs)
      // keeps the count of each listed module from growing (#613).
      "files": [
        "**/assets/ui/app.ts",
        "**/assets/ui/globals.d.ts",
        "**/assets/ui/wb-add-project-dialog.ts",
        "**/assets/ui/wb-add-project.ts",
        "**/assets/ui/wb-changes.ts",
        "**/assets/ui/wb-columns.ts",
        "**/assets/ui/wb-console-chrome.ts",
        "**/assets/ui/wb-console-desk.ts",
        "**/assets/ui/wb-console-detach.ts",
        "**/assets/ui/wb-console-fence-list.ts",
        "**/assets/ui/wb-console-fences.ts",
        "**/assets/ui/wb-console-gpu.ts",
        "**/assets/ui/wb-console-input.ts",
        "**/assets/ui/wb-console-name.ts",
        "**/assets/ui/wb-console-popups.ts",
        "**/assets/ui/wb-console-session.ts",
        "**/assets/ui/wb-console-terminal.ts",
        "**/assets/ui/wb-console-title.ts",
        "**/assets/ui/wb-console-view.ts",
        "**/assets/ui/wb-console.ts",
        "**/assets/ui/wb-consoles-tab.ts",
        "**/assets/ui/wb-daemon.ts",
        "**/assets/ui/wb-detach-link.ts",
        "**/assets/ui/wb-detached-fence.ts",
        "**/assets/ui/wb-detached.ts",
        "**/assets/ui/wb-device.ts",
        "**/assets/ui/wb-devices.ts",
        "**/assets/ui/wb-fail.ts",
        "**/assets/ui/wb-file-paths.ts",
        "**/assets/ui/wb-files.ts",
        "**/assets/ui/wb-fleet.ts",
        "**/assets/ui/wb-kanban.ts",
        "**/assets/ui/wb-monaco.ts",
        "**/assets/ui/wb-move-dialog.ts",
        "**/assets/ui/wb-notes.ts",
        "**/assets/ui/wb-project.ts",
        "**/assets/ui/wb-projects-store.ts",
        "**/assets/ui/wb-release-dialogs.ts",
        "**/assets/ui/wb-runs.ts",
        "**/assets/ui/wb-security-dialog.ts",
        "**/assets/ui/wb-spend.ts",
        "**/assets/ui/wb-view.ts",
        "**/assets/ui/wb-viewer.ts",
      ],
      "rules": { "typescript/no-explicit-any": "off" }
    }
  ]
}
