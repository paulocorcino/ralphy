{
  // Lints the workbench JS: crates/ralphy-daemon/assets/ui and ui-tests.
  "plugins": ["eslint", "import", "oxc", "promise", "typescript", "unicorn"],
  "categories": {"correctness": "error", "pedantic": "error", "suspicious": "error"},
  "env": { "browser": true, "es2024": true },
  "ignorePatterns": ["**/vendor/**"],
  "rules": {
    // Every `for (… of [...coll])` in the UI is a snapshot taken because the
    // loop body mutates `coll`. Removing the spread would break that loop.
    "unicorn/no-useless-spread": "off",
    // wb-project.js matches control characters on purpose: a worktree name
    // must not contain them.
    "no-control-regex": "off",
    "no-unused-vars": ["error", { "args": "none", "caughtErrors": "none", "ignoreRestSiblings": true }],
    // `== null` is the one loose comparison the UI uses: it means null or undefined.
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    // `catch {}` is used where the failure has no reader, such as closing a
    // socket that is already gone.
    "no-empty": ["error", { "allowEmptyCatch": true }],
    // No `any` in any module, with no exception (ADR-0075 D6, #613).
    // `explicit_any_matches_the_baseline` (crates/xtask/tests/ratchets/)
    // fails on a new one too.
    "typescript/no-explicit-any": "error",
    // A value that may be missing gets a guard the compiler reads, not a `!`
    // (#804).
    "typescript/no-non-null-assertion": "error",
    // `scrim()` in app.ts keeps `this` as `self`: Alpine calls `x-effect` with
    // its own `this`, so the arrow-function fix does not apply there.
    "typescript/no-this-alias": "off",
    // A function may score 10 (ADR-0081). `modified` counts a `switch` once.
    // An exception is a `// oxlint-disable-next-line complexity -- <reason>`
    // line, counted by `complexity_exceptions_do_not_grow`.
    "complexity": ["error", { "max": 10, "variant": "modified" }],
    // The rules of #803. The `typescript/` rules that read the types run only
    // with `--type-aware` (tsgolint), on the modules: the command is in AGENTS.md.
    // A Promise is awaited, voided or caught.
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/await-thenable": "error",
    "typescript/return-await": ["error", "in-try-catch"],
    "typescript/require-await": "error",
    // A value is used as the type it has.
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-base-to-string": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/require-array-sort-compare": "error",
    "typescript/no-deprecated": "error",
    "typescript/unbound-method": "error",
    "typescript/only-throw-error": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/no-unsafe-enum-comparison": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/consistent-type-exports": "error",
    // Imports and the shape of the code.
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "import/first": "error",
    // An import names the file with its `.ts` extension, as tsconfig.json
    // explains.
    "import/extensions": ["error", "always"],
    "no-shadow": "error",
    "max-depth": ["error", { "max": 3 }],
    "no-nested-ternary": "error",
    "no-else-return": ["error", { "allowElseIf": false }],
    "prefer-arrow-callback": "error",
    // The lint gate. A rule `off` below is one of two kinds. `debt`: it has
    // sites today and docs/lint/lint-transition.md turns it on; this list only shrinks.
    // `noise`: off for good, with the reason.
    "default-case-last": "error",
    "import/no-default-export": "error",
    "unicorn/error-message": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/throw-new-error": "error",
    "curly": ["error", "multi-line"],
    "typescript/strict-boolean-expressions": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/no-unnecessary-condition": "error",
    "no-implicit-coercion": "error",
    "typescript/no-unnecessary-type-conversion": "error",
    "unicorn/explicit-length-check": "error",
    "unicorn/prefer-number-coercion": "error",
    "typescript/no-unnecessary-boolean-literal-compare": "error",
    "typescript/no-confusing-void-expression": "error",
    "typescript/strict-void-return": "error",
    "typescript/consistent-return": "error",
    "require-await": "error",
    "no-promise-executor-return": "error",
    "promise/always-return": "error",
    "promise/no-callback-in-promise": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-unnecessary-type-parameters": "error",
    "require-unicode-regexp": "error",
    "unicorn/consistent-function-scoping": "error",
    // debt: 46 sites
    "no-restricted-properties": "off",
    "unicorn/prefer-add-event-listener": "error",
    "unicorn/no-array-sort": "error",
    // debt: 38 sites
    "no-console": "off",
    "unicorn/prefer-query-selector": "error",
    "unicorn/no-array-callback-reference": "error",
    "max-params": ["error", { "max": 4 }],
    "unicorn/no-negated-condition": "error",
    "no-var": "error",
    "no-param-reassign": "error",
    "max-classes-per-file": "error",
    "no-new-func": "error",
    "prefer-const": "error",
    "unicorn/prefer-dom-node-dataset": "error",
    "no-script-url": "error",
    "typescript/no-extraneous-class": "error",
    "unicorn/no-object-as-default-parameter": "error",
    "unicorn/no-this-assignment": "error",
    "accessor-pairs": "error",
    "no-redeclare": "error",
    "no-unmodified-loop-condition": "error",
    "import/no-named-as-default": "error",
    "oxc/no-accumulating-spread": "error",
    "unicorn/no-array-reverse": "error",
    "unicorn/no-immediate-mutation": "error",
    "unicorn/no-static-only-class": "error",
    "unicorn/prefer-type-error": "error",
    // debt: 1 site
    "unicorn/require-post-message-target-origin": "off",
    // noise: file size is xtask oversized, one tool per property (D4)
    "max-lines": "off",
    // noise: function complexity is the limit; length alone flags long flat code (D4)
    "max-lines-per-function": "off",
    // noise: a short comment at the end of a line is the repo's style (D4)
    "no-inline-comments": "off",
    // noise: the same check as unicorn/no-negated-condition, one tool per property (D4)
    "no-negated-condition": "off",
    // noise: a leading underscore marks a private field of an Alpine component (D4)
    "no-underscore-dangle": "off",
    // noise: declaration order is a style choice (D4)
    "sort-vars": "off",
    // noise: a module's size is held by complexity and file size (D4)
    "import/max-dependencies": "off",
    // noise: ui-tests/index.mjs imports each test file for its side effect (D4)
    "import/no-unassigned-import": "off",
    // noise: a readonly type on every parameter; the Alpine components and stores change their own state (D4)
    "typescript/prefer-readonly-parameter-types": "off"
  },
  "overrides": [
    // Test code is not measured for complexity (ADR-0081 D3).
    { "files": ["**/ui-tests/**"], "env": { "node": true }, "rules": { "complexity": "off" } },
    // `globals.d.ts` is a script: it names other modules' types with `import()`,
    // because a top-level `import` would make it a module and its names not global.
    {
      "files": ["**/globals.d.ts"],
      "rules": { "typescript/consistent-type-imports": "off" }
    }
  ]
}
