# agy plan, ADR-0040 C1/C2/C3 (stage 4 of the agy spike, 2026-11-12).
# Windows 11, agy 1.5.6, isolated root --gemini_dir=<tmp>\gd (auth from the Windows keyring),
# cwd = a scratch git repo <tmp>\repo, stdin = a file or /dev/null (never a terminal).
# Spawned by a Python harness (subprocess, own pid); <tmp> = %LOCALAPPDATA%\Temp\agy782s4.

## 1. C1 — the prompt channel. Each probe used --print-timeout 1ms, so the turn is cut before
## any model call (0 tokens); the CLI log line `Print mode: starting (promptLength=N, ...)` shows
## which text became the prompt. stdin1.txt = "Reply with the word STDIN.\n" (27 bytes).

$ agy -p --model gemini-3.8-flash-low --output-format json --print-timeout 1ms   < stdin1.txt
exit=2
--- stderr:
Error: -p took "--model" as its prompt, so the intended prompt was left as an argument and ignored.

$ agy --model gemini-3.8-flash-low --output-format json --print-timeout 1ms -p   < stdin1.txt
exit=2
--- stderr:
flag needs an argument: -p

$ agy --model gemini-3.8-flash-low --output-format json --print-timeout 1ms -p ""   < stdin1.txt
exit=1
--- stdout:
{"conversation_id":"","status":"ERROR","response":"","error":"Error: empty prompt. Usage: agy --print \"your prompt here\"","duration_seconds":0.0898547,"num_turns":0,"usage":{"input_tokens":0,"output_tokens":0,"thinking_tokens":0,"cache_read_tokens":0,"total_tokens":0},"finished_reason":"error"}
--- cli.log: Print mode: starting (promptLength=0, model="gemini-3.8-flash-low", conversationID="")

$ agy --model gemini-3.8-flash-low --output-format json --print-timeout 1ms -p -   < stdin1.txt
exit=3
--- cli.log: Print mode: starting (promptLength=1, ...)      ## "-" is a literal prompt, not "read stdin"

$ agy --model gemini-3.8-flash-low --output-format json --print-timeout 1ms -p ARG   < stdin1.txt
exit=3
--- cli.log: Print mode: starting (promptLength=3, ...)      ## stdin is ignored when -p has a value

$ agy --model gemini-3.8-flash-low --output-format json --print-timeout 1ms   < stdin1.txt
exit=3
--- stdout:
{"conversation_id":"46fd71df-22ab-48f1-a264-ef6946abb45c","status":"ERROR","response":"","error":"print timeout after 1ms with the turn still in progress; the response is partial","duration_seconds":0,"num_turns":0,"usage":{"input_tokens":0,"output_tokens":0,"thinking_tokens":0,"cache_read_tokens":0,"total_tokens":0},"finished_reason":"print_timeout"}
--- stderr:
[agy] print timeout after 1ms with turn in progress; returning partial output
--- cli.log: Print mode: starting (promptLength=27, ...)     ## no -p + piped stdin = print mode, stdin is the prompt

## A large stdin prompt: 72 025 bytes (57 625 characters, UTF-8 with "ação ✓ 日本" on each line)
$ agy --model gemini-3.8-flash-low --output-format json --print-timeout 1ms   < stdin_big.txt
exit=3
--- cli.log: Print mode: starting (promptLength=72025, model="gemini-3.8-flash-low", conversationID="")

## stdin written 3 s after the spawn (no grace timer: the CLI waits for EOF)
$ agy --model gemini-3.8-flash-low --output-format json --print-timeout 1ms   (stdin: pipe, written after 3.0 s)
exit=3
--- cli.log: Print mode: starting (promptLength=26, ...)
--- stderr (full):
