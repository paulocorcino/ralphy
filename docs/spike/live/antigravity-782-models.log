## 4. --effort against the id suffix. All with --print-timeout 1ms (no model call).
$ agy -p "Reply with OK" --model gemini-3.8-flash --effort bogus --output-format json --print-timeout 1ms
exit=1   error: invalid model selection (--model "gemini-3.8-flash" --effort "bogus"): invalid --effort "bogus" (valid: low, medium, high, xhigh, max)
$ agy -p "Reply with OK" --effort bogus ...
exit=1   error: invalid model selection (--model "" --effort "bogus"): invalid --effort "bogus" (valid: low, medium, high, xhigh, max)
$ agy -p "Reply with OK" --model gemini-3.8-flash-low --effort max ...
exit=1   error: invalid model selection (--model "gemini-3.8-flash-low" --effort "max"): --model gemini-3.8-flash-low conflicts with --effort=max
$ agy -p "Reply with OK" --model gpt-oss-120b --effort high ...
exit=1   error: invalid model selection (--model "gpt-oss-120b" --effort "high"): gpt-oss-120b has no "high" effort (available: medium)
$ agy -p "Reply with OK" --model gemini-3.8-flash --effort xhigh ...
exit=1   error: invalid model selection (--model "gemini-3.8-flash" --effort "xhigh"): gemini-3.8-flash has no "xhigh" effort (available: low, medium, high)
$ agy -p "Reply with OK" --model claude-opus-5-5 --effort max ...
exit=1   error: invalid model selection (--model "claude-opus-5-5" --effort "max"): claude-opus-5-5 has no "max" effort (available: low, medium, high)
$ agy -p "Reply with OK" --model gemini-3.8-flash ...                      (base id, no --effort)
exit=3   (accepted; cut by the 1 ms timeout)
--- cli.log: model alias "gemini-3.8-flash" resolved to "gemini-3.8-flash-medium"
$ agy --model gemini-3.8-flash --effort low --output-format stream-json --print-timeout 1ms   < stdin1.txt
exit=3   (accepted)
--- stdout: {"event":"init","conversation_id":"69b49994-…","init":{"model":"gemini-3.8-flash",...}}   ## init echoes argv, not the resolved id
--- cli.log: model alias "gemini-3.8-flash" resolved to "gemini-3.8-flash-low"
$ agy -p "Reply with OK" --model gemini-3.8-flash-low --effort low ...
exit=3   (accepted: the same effort as the suffix is not a conflict)

