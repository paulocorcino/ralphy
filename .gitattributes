# Every text file checks out with LF on every machine. The format checks
# (oxfmt, taplo fmt, editorconfig-checker) read the working tree, so a CRLF
# checkout on Windows would make them depend on the machine.
* text=auto eol=lf

# Binary files: no line-ending conversion and no text diff.
*.png binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.gz binary

# The vendored UI files are hashed in vendor/manifest.json, and include_dir!
# embeds the working-tree bytes. No checkout may convert their line endings.
crates/ralphy-daemon/assets/ui/vendor/** -text
