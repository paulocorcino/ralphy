# Prompt sources and assembled artifacts are byte-compared by the
# prompt_assembly anti-drift tests; pin LF so Windows autocrlf checkouts
# cannot manufacture a false drift between template and artifact.
assets/prompts/** text eol=lf

# The vendored UI files are hashed in vendor/manifest.json, and include_dir!
# embeds the working-tree bytes. No checkout may convert their line endings.
crates/ralphy-daemon/assets/ui/vendor/** -text

# The install script runs under sh and is served from main as it is.
assets/install/install.sh text eol=lf

# oxfmt writes LF (.oxfmtrc.json). Git stores LF, so a checkout with CRLF
# would make the format check depend on the machine.
crates/ralphy-daemon/assets/ui/*.ts text eol=lf
