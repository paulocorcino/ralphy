# Rust build artifacts (workspace target dir).
/target/

# Release packaging staging dir (produced by the Release workflow).
/dist/

# Ralphy writes run logs/scratch into the TARGET repo's .ralphy/, not here.
# These patterns are only a safety net for stray local runtime artifacts.
runs/
worktrees/
state/
# Ralphy run artifacts (scratch, logs, per-run plans)
.ralphy/

# Python bytecode from running the bundled skill scripts in place — never
# commit: include_dir embeds everything under assets/plugin into the binary.
__pycache__/
*.pyc
docs/old/exec.md
docs/old/plan-charter.md
docs/oracle/
docs/research/plan_friction/*
# The IMAGES only. A screenshot is evidence for one gate run — it is regenerated
# by the acceptance script that produced it, so versioning it adds a new blob per
# run and nothing a reader can diff. Anything else that belongs in that folder (a
# README naming the convention, an index) is ordinary source and stays tracked,
# which a bare `docs/screenshots/` would have swallowed too.
docs/screenshots/*.png
